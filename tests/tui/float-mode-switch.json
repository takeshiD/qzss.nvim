{
  "launch": { "argv": ["nvim", "--clean", "-u", "tests/minimal_init.lua", "tests/fixtures/rust/src/lib.rs"], "cols": 120, "rows": 32 },
  "steps": [
    { "do": "wait_text", "text": "use std::fmt", "timeout_ms": 10000 },
    { "do": "type", "text": ":QzssFloat" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "╭─", "timeout_ms": 5000 },
    { "do": "expect_text", "text": "qzss · lib.rs" },
    { "do": "expect_text", "text": "treesitter · ? help ╯" },
    { "do": "expect_text", "text": "│▾ ⊃ impl Default for MyStruct<i32>  impl trait" },
    { "do": "expect_no_text", "text": "│~" },
    { "do": "capture", "name": "float-open" },
    { "do": "type", "text": "/impl<T> Shape" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": "za" },
    { "do": "wait_text", "text": "│▸ ⊃ impl<T> Shape<T> for MyStruct<T> [+4]", "timeout_ms": 3000 },
    { "do": "type", "text": ":QzssSidebar" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_gone", "text": "╭─", "timeout_ms": 3000 },
    { "do": "wait_text", "text": "│ qzss · lib.rs · treesitter · ? help", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "│▸ ⊃ impl<T> Shape<T> for MyStruct<T> [+4]" },
    { "do": "type", "text": ":lua print('cur=' .. vim.api.nvim_get_current_line() .. ' ft=' .. vim.bo.filetype)" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "cur=▸ ⊃ impl<T> Shape<T> for MyStruct<T> [+4]", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "ft=qzss" },
    { "do": "type", "text": ":QzssFilter Struct Enum" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "Enum,Struct · ? help", "timeout_ms": 3000 },
    { "do": "expect_no_text", "text": "◈ Shape<T>  trait" },
    { "do": "capture", "name": "switched-to-sidebar" },
    { "do": "type", "text": ":QzssFloat" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "╭─", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "filter:Enum,Struct" },
    { "do": "expect_text", "text": "│  ◆ MyStruct<T>  struct" },
    { "do": "expect_no_text", "text": "◈ Shape<T>  trait" },
    { "do": "type", "text": ":QzssFilter" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "◈ Shape<T>  trait", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "│▸ ⊃ impl<T> Shape<T> for MyStruct<T> [+4]" },
    { "do": "capture", "name": "back-to-float" },
    { "do": "press", "keys": ["Escape"] },
    { "do": "wait_gone", "text": "╭─", "timeout_ms": 3000 },
    { "do": "type", "text": ":lua print('ft=' .. vim.bo.filetype .. ' wins=' .. #vim.api.nvim_tabpage_list_wins(0))" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "ft=rust wins=1", "timeout_ms": 3000 },
    { "do": "type", "text": ":qa!" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_exit", "exit_code": 0, "timeout_ms": 5000 }
  ]
}
