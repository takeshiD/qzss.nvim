{
  "launch": { "argv": ["nvim", "--clean", "-u", "tests/minimal_init.lua", "tests/fixtures/ts/sample.ts"], "cols": 100, "rows": 30 },
  "steps": [
    { "do": "wait_text", "text": "interface Shape", "timeout_ms": 10000 },
    { "do": "type", "text": ":help qzss-float" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "FLOAT LAYOUT", "timeout_ms": 3000 },
    { "do": "type", "text": ":QzssFloat" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss: current buffer is not a file buffer", "timeout_ms": 3000 },
    { "do": "expect_no_text", "text": "╭─" },
    { "do": "type", "text": ":close" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": ":enew" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": ":setfiletype text" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": ":QzssFloat" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss: no Tree-sitter extractor for filetype 'text'", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "qzss · [No Name]" },
    { "do": "capture", "name": "unsupported-filetype" },
    { "do": "press", "keys": ["Escape"] },
    { "do": "wait_gone", "text": "╭─", "timeout_ms": 3000 },
    { "do": "type", "text": ":buffer 1" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": ":QzssFloat" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "© Box<T> implements Shape<number>  class", "timeout_ms": 3000 },
    { "do": "type", "text": ":edit tests/fixtures/sample.yaml" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_gone", "text": "╭─", "timeout_ms": 3000 },
    { "do": "wait_text", "text": "quoted key", "timeout_ms": 3000 },
    { "do": "type", "text": ":lua print('wins=' .. #vim.api.nvim_tabpage_list_wins(0) .. ' ft=' .. vim.bo.filetype .. ' open=' .. tostring(require('qzss').is_open()))" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "wins=1 ft=yaml open=false", "timeout_ms": 3000 },
    { "do": "type", "text": ":QzssFloat!" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss · sample.yaml", "timeout_ms": 3000 },
    { "do": "type", "text": ":bwipeout! %" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_gone", "text": "qzss · sample.yaml", "timeout_ms": 3000 },
    { "do": "type", "text": ":lua print('after-wipe open=' .. tostring(require('qzss').is_open()) .. ' src=' .. tostring((require('qzss').get_view() or {}).source_bufnr) .. ' valid=' .. tostring(require('qzss').get_view() == nil or vim.api.nvim_buf_is_valid(require('qzss').get_view().source_bufnr)))" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "valid=true", "timeout_ms": 3000 },
    { "do": "type", "text": ":qa!" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_exit", "exit_code": 0, "timeout_ms": 5000 }
  ]
}
