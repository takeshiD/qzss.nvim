{
 "launch": {
  "argv": ["nvim",
   "--clean",
   "-u",
   "tests/minimal_init.lua",
   "tests/fixtures/rust/src/lib.rs"], "cols": 100, "rows": 30 },
 "steps": [
  { "do": "wait_text", "text": "use std::fmt", "timeout_ms": 10000 },
  { "do": "type", "text": ":QzssFloat!" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "╭─", "timeout_ms": 5000 },
  { "do": "type", "text": "19G" },
  { "do": "type", "text": ":lua print('ft=' .. vim.bo.filetype .. ' line=' .. vim.fn.line('.'))" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "ft=rust line=19", "timeout_ms": 3000 },
  { "do": "expect_text", "text": "╭─" },
  { "do": "resize", "cols": 40, "rows": 12 },
  { "do": "wait_text", "text": "╭", "timeout_ms": 3000 },
  { "do": "wait_text", "text": "╯", "timeout_ms": 3000 },
  { "do": "capture", "name": "narrow-40x12" },
  { "do": "type", "text": ":lua local c=vim.api.nvim_win_get_config(require('qzss').get_view().winid) print(('fit=%s'):format(c.col+c.width+2<=vim.o.columns and c.row+c.height+2<=vim.o.lines-1))" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "fit=true", "timeout_ms": 3000 },
  { "do": "resize", "cols": 100, "rows": 30 },
  { "do": "wait_text", "text": "qzss · lib.rs", "timeout_ms": 3000 },
  { "do": "type", "text": ":tabnew tests/fixtures/sample.json" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "deep key", "timeout_ms": 3000 },
  { "do": "expect_no_text", "text": "qzss · lib.rs" },
  { "do": "type", "text": ":QzssSidebar!" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "qzss · sample.json", "timeout_ms": 3000 },
  { "do": "type", "text": "gt" },
  { "do": "wait_text", "text": "qzss · lib.rs", "timeout_ms": 3000 },
  { "do": "expect_text", "text": "╭─" },
  { "do": "expect_no_text", "text": "qzss · sample.json" },
  { "do": "type", "text": "gt" },
  { "do": "wait_text", "text": "qzss · sample.json", "timeout_ms": 3000 },
  { "do": "type", "text": ":tabclose" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_gone", "text": "sample.json", "timeout_ms": 3000 },
  { "do": "type", "text": ":lua print('views=' .. vim.tbl_count(require('qzss')._state.views) .. ' tabs=' .. #vim.api.nvim_list_tabpages())" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "views=1 tabs=1", "timeout_ms": 3000 },
  { "do": "type", "text": ":QzssFloat" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "type", "text": "/helper" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_gone", "text": "╭─", "timeout_ms": 3000 },
  { "do": "wait_text", "text": "33,12", "timeout_ms": 3000 },
  { "do": "type", "text": ":lua print('after-jump ft=' .. vim.bo.filetype .. ' open=' .. tostring(require('qzss').is_open()))" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "after-jump ft=rust open=false", "timeout_ms": 3000 },
  { "do": "type", "text": ":QzssFloat!" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_text", "text": "╭─", "timeout_ms": 3000 },
  { "do": "type", "text": ":q" },
  { "do": "press", "keys": ["Enter"] },
  { "do": "wait_exit", "exit_code": 0, "timeout_ms": 5000 }
 ]
}