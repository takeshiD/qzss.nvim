{
  "launch": { "argv": ["nvim", "--clean", "-u", "tests/minimal_init.lua", "tests/fixtures/sample.json"], "cols": 140, "rows": 36 },
  "steps": [
    { "do": "wait_text", "text": "deep key", "timeout_ms": 10000 },
    { "do": "type", "text": ":Qzss" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss · sample.json", "timeout_ms": 5000 },
    { "do": "expect_text", "text": "▾ {} \"deep key\" {2}  object" },
    { "do": "expect_text", "text": "\" [1]: \"two\"  string" },
    { "do": "capture", "name": "json" },
    { "do": "type", "text": ":edit tests/fixtures/sample.yaml" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss · sample.yaml", "timeout_ms": 5000 },
    { "do": "expect_text", "text": "\" 'quoted key': yes  string" },
    { "do": "expect_text", "text": "▾ {} \"deep key\" {2}  object" },
    { "do": "expect_text", "text": "▾ [] list [3]  array" },
    { "do": "expect_text", "text": "▾ [] b [2]  array" },
    { "do": "expect_text", "text": "◐ enabled: true  bool" },
    { "do": "capture", "name": "yaml" },
    { "do": "type", "text": ":enew" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": ":setf yaml" }, { "do": "press", "keys": ["Enter"] },
    { "do": "type", "text": "i\"two  spaces\": 1\n\"two spaces\": 2\nplain  key: a  b" }, { "do": "press", "keys": ["Escape"] },
    { "do": "wait_text", "text": "# \"two  spaces\": 1  number", "timeout_ms": 5000 },
    { "do": "expect_text", "text": "# \"two spaces\": 2  number" },
    { "do": "expect_text", "text": "\" plain  key: a  b  string" },
    { "do": "capture", "name": "yaml-spaces" },
    { "do": "resize", "cols": 70, "rows": 20 },
    { "do": "press", "keys": ["Escape"] },
    { "do": "wait_text", "text": "# \"two  spaces\": 1  number", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "\"two  spaces\": 1   ", "col": 0 },
    { "do": "expect_text", "text": "plain  key: a  b", "col": 0 },
    { "do": "expect_text", "text": "qzss · [No Name]" },
    { "do": "type", "text": ":lua print('src-w='..vim.api.nvim_win_get_width(0)..' ok='..tostring(vim.api.nvim_win_get_width(0) >= 30))" },
    { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "ok=true", "timeout_ms": 3000 },
    { "do": "capture", "name": "narrow" },
    { "do": "type", "text": ":qa!" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_exit", "exit_code": 0, "timeout_ms": 5000 }
  ]
}
