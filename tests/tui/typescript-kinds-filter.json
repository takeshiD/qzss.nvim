{
  "launch": { "argv": ["env", "QZSS_SETUP={\"layout\":{\"width\":70,\"max_width\":70}}", "nvim", "--clean", "-u", "tests/minimal_init.lua", "tests/fixtures/ts/sample.ts"], "cols": 160, "rows": 36 },
  "steps": [
    { "do": "wait_text", "text": "export interface Shape", "timeout_ms": 10000 },
    { "do": "type", "text": ":QzssOpen" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss · sample.ts · treesitter", "timeout_ms": 5000 },
    { "do": "expect_text", "text": "ⓘ Shape<T extends number = number>  interface" },
    { "do": "expect_text", "text": "≡ Pair<K, V> = { key: K; value: V }  type" },
    { "do": "expect_text", "text": "© Box<T> implements Shape<number>  class" },
    { "do": "expect_text", "text": "ƒ identity<T>(value: T): T  fn" },
    { "do": "capture", "name": "ts-kinds" },
    { "do": "type", "text": ":QzssFilter Interface" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "filter:Interface", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "ⓘ Shape<T extends number = number>  interface" },
    { "do": "expect_no_text", "text": "© Box<T>" },
    { "do": "expect_no_text", "text": "≡ Pair<K, V>" },
    { "do": "capture", "name": "ts-filter-interface" },
    { "do": "type", "text": ":QzssFilter TypeAlias" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "filter:TypeAlias", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "≡ Pair<K, V>" },
    { "do": "expect_no_text", "text": "ⓘ Shape<T" },
    { "do": "expect_no_text", "text": "© Box<T>" },
    { "do": "type", "text": ":QzssFilter Bogus" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "unknown kind 'Bogus'", "timeout_ms": 3000 },
    { "do": "type", "text": ":QzssFilter" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "© Box<T> implements Shape<number>  class", "timeout_ms": 3000 },

    { "do": "type", "text": ":edit tests/fixtures/ts/view.tsx" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss · view.tsx · treesitter", "timeout_ms": 5000 },
    { "do": "expect_text", "text": "ⓘ Props  interface" },
    { "do": "expect_text", "text": "≡ Variant = \"primary\" | \"secondary\"  type" },
    { "do": "expect_text", "text": "© Panel extends React.Component<Props>  class" },
    { "do": "type", "text": ":lua print('qzss-win='..(vim.bo.filetype)..' '..vim.fn.expand('%:t')..' wins='..#vim.api.nvim_tabpage_list_wins(0))" },
    { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "qzss-win=typescriptreact view.tsx wins=2", "timeout_ms": 3000 },
    { "do": "capture", "name": "tsx-kinds" },
    { "do": "type", "text": ":qa!" }, { "do": "press", "keys": ["Enter"] },
    { "do": "wait_exit", "exit_code": 0, "timeout_ms": 5000 }
  ]
}
